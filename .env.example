# DevPrep AI - Environment Variables Reference (.env.example)

# Backend Environment Settings (Place in backend/.env)
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database & Cache Configurations
MONGODB_URI=mongodb://127.0.0.1:27017/devprepAI
REDIS_URL=redis://127.0.0.1:6379

# Authentication & Security
JWT_SECRET=your_jwt_secret_hash_here
REFRESH_TOKEN_SECRET=your_refresh_secret_hash_here

# AI Service (Google Gemini)
GOOGLE_API_KEY=your_google_gemini_api_key_here
GEMINI_API_KEY=your_google_gemini_api_key_here

# Third-Party Integrations
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Email Service (Nodemailer)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
